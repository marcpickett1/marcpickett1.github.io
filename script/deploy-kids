#!/usr/bin/env python3
"""Build and deploy the password-protected kids' section as its own site.

The main site (marcpickett.com) is built by GitHub Pages straight from the
master branch, so ordinary posts need no deploy step at all. This script only
handles rhuarkpetra/, which is gitignored and must be encrypted before it is
published. The output goes to the separate repo marcpickett1/rhuarkpetra,
which GitHub serves as a project site at marcpickett.com/rhuarkpetra/.

Steps: split rhuarkpetra/kids.md into posts, assemble a small Jekyll source
tree, build it with baseurl /rhuarkpetra, encrypt every page with staticrypt,
and force-push the result to the rhuarkpetra repo's main branch.
"""
import os, re, shutil, subprocess, sys
from os.path import expanduser

BLOG_DIR    = expanduser('~/blog')
KIDS_DIR    = os.path.join(BLOG_DIR, 'rhuarkpetra')
SOURCE      = os.path.join(KIDS_DIR, 'kids.md')
POSTS_DIR   = os.path.join(KIDS_DIR, '_posts')
BUILD_SRC   = os.path.join(BLOG_DIR, '.kids-src')    # assembled Jekyll source
BUILD_SITE  = os.path.join(BLOG_DIR, '.kids-site')   # built output
DEPLOY_REPO = 'git@github.com:marcpickett1/rhuarkpetra.git'
DEPLOY_BRANCH = 'main'

KEY_CHARS = set('1234567890abcdefghijklmnopqrstuvwxyz'
                'ABCDEFGHIJKLMNOPQRSTUVWXYZ@#%^-=,.~_+:')
WEB_EXTENSIONS = {'.html', '.xml', '.json', '.css'}

KIDS_CONFIG = """\
title: More Debris
url: https://marcpickett.com
baseurl: /rhuarkpetra
theme: jekyll-theme-slate
"""


def is_header(lines, i):
    return lines[i].startswith('# ') and lines[i+1].startswith('#### ')

def post_filename(title_line, date_line):
    date = '-'.join(date_line.split()[1].split('/')[:3])
    slug = ''.join(c for c in '-'.join(title_line[2:].split()) if c in KEY_CHARS)
    return f'{date}-{slug}.md'

def is_ref_def(line):
    return re.match(r'^\[.*\]: ', line) is not None

def split_posts():
    lines = open(SOURCE).read().splitlines()
    fnames, titles, bodies, defs = [], [], [], []
    lasthead = 0
    i = 0
    while i < len(lines) - 4:
        if is_header(lines, i):
            fname = post_filename(lines[i], lines[i+1])
            assert fname not in fnames, f'Duplicate post: {fname}'
            fnames.append(fname)
            bodies.append(lines[lasthead:i])
            titles.append(''.join(c for c in lines[i][2:] if c != '"'))
            lasthead = i
        elif is_ref_def(lines[i]):
            defs.append(lines[i])
        i += 1
    bodies.append(lines[lasthead:])
    bodies.pop(0)

    os.makedirs(POSTS_DIR, exist_ok=True)
    for idx, fname in enumerate(fnames):
        path = os.path.join(POSTS_DIR, fname)
        with open(path, 'w') as f:
            f.write(f'---\nlayout: post\ntitle: "{titles[idx]}"\n'
                    f'secondary: secondary\n---\n\n')
            if defs:
                f.write('\n'.join(defs) + '\n\n')
            for line in bodies[idx][2:]:
                f.write(line + '\n')

    stale = set(os.listdir(POSTS_DIR)) - set(fnames)
    for name in sorted(stale):
        print(f'Removing stale post: {name}')
        os.remove(os.path.join(POSTS_DIR, name))
    print(f'Split into {len(fnames)} posts.')

def run(args, cwd=BLOG_DIR):
    print('+', ' '.join(str(a) for a in args))
    subprocess.run(args, check=True, cwd=cwd)

def has_front_matter(path):
    with open(path, errors='replace') as f:
        return f.readline().strip() == '---'

def assemble_source():
    """Build a self-contained Jekyll source tree for the kids' site.
    Layouts and styles come from the main blog so the two sites match.
    Only pages are copied, never the photos and videos in pics/ (54 GB)."""
    shutil.rmtree(BUILD_SRC, ignore_errors=True)
    os.makedirs(BUILD_SRC)
    with open(os.path.join(BUILD_SRC, '_config.yml'), 'w') as f:
        f.write(KIDS_CONFIG)
    for d in ('_layouts', '_sass'):
        shutil.copytree(os.path.join(BLOG_DIR, d), os.path.join(BUILD_SRC, d))
    os.makedirs(os.path.join(BUILD_SRC, 'assets', 'css'))
    shutil.copy2(os.path.join(BLOG_DIR, 'assets', 'css', 'style.scss'),
                 os.path.join(BUILD_SRC, 'assets', 'css', 'style.scss'))
    shutil.copytree(POSTS_DIR, os.path.join(BUILD_SRC, '_posts'))
    for name in os.listdir(KIDS_DIR):
        src = os.path.join(KIDS_DIR, name)
        if name.endswith('.md') and os.path.isfile(src) and has_front_matter(src):
            shutil.copy2(src, os.path.join(BUILD_SRC, name))
    pics_html = [n for n in os.listdir(os.path.join(KIDS_DIR, 'pics'))
                 if n.endswith('.html')]
    if pics_html:
        os.makedirs(os.path.join(BUILD_SRC, 'pics'))
        for n in pics_html:
            shutil.copy2(os.path.join(KIDS_DIR, 'pics', n),
                         os.path.join(BUILD_SRC, 'pics', n))
    print(f'Assembled source in {BUILD_SRC}')

def build():
    shutil.rmtree(BUILD_SITE, ignore_errors=True)
    run(['bundle', 'exec', 'jekyll', 'build', '-s', BUILD_SRC, '-d', BUILD_SITE])

def encrypt():
    password = os.environ.get('KIDS_PASSWORD')
    if not password:
        sys.exit('KIDS_PASSWORD environment variable is not set.')
    count = 0
    for root, _, files in os.walk(BUILD_SITE):
        for fname in files:
            if fname.endswith('.html'):
                fpath = os.path.join(root, fname)
                subprocess.run(['staticrypt', fpath, '--password', password,
                                '-d', root], check=True, capture_output=True)
                count += 1
    print(f'Encrypted {count} pages.')

def strip_non_web():
    """Safety net: never publish anything but web files."""
    removed = 0
    for root, _, files in os.walk(BUILD_SITE):
        for fname in files:
            if os.path.splitext(fname)[1].lower() not in WEB_EXTENSIONS:
                os.remove(os.path.join(root, fname))
                removed += 1
    if removed:
        print(f'Stripped {removed} non-web files.')

def deploy():
    """Push the built site as a single fresh commit to the rhuarkpetra repo."""
    open(os.path.join(BUILD_SITE, '.nojekyll'), 'w').close()
    git = lambda *a: run(['git', *a], cwd=BUILD_SITE)
    git('init', '-q', '-b', DEPLOY_BRANCH)
    git('add', '-A')
    git('commit', '-q', '-m', 'Deploy kids site')
    git('push', '-f', DEPLOY_REPO, f'HEAD:{DEPLOY_BRANCH}')


if __name__ == '__main__':
    split_posts()
    assemble_source()
    build()
    encrypt()
    strip_non_web()
    deploy()
    print('Deployed. Live in a minute or two at https://marcpickett.com/rhuarkpetra/')
